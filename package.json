{
  "name": "virtual-browser-remote",
  "version": "1.0.0",
  "description": "A remote virtual desktop environment for browsing websites and accessing repositories",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy": "^1.18.1",
    "puppeteer": "^20.0.0",
    "playwright": "^1.40.0",
    "socket.io": "^4.6.1",
    "dotenv": "^16.3.1",
    "axios": "^1.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
