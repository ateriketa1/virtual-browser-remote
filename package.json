const state = {
  sessionId: null,
  currentUrl: 'https://google.com',
  title: 'New session'
};

const browserView = document.getElementById('browserView');
const emptyState = document.getElementById('emptyState');
const addressInput = document.getElementById('addressInput');
const statusText = document.getElementById('statusText');
const browserTitle = document.getElementById('browserTitle');

async function createSession() {
  statusText.textContent = 'Creating session...';

  try {
    const response = await fetch('/api/browser/create-session', { method: 'POST' });
    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || 'Failed to create session');
    }

    state.sessionId = data.sessionId;
    addressInput.value = state.currentUrl;
    await navigate(state.currentUrl);
  } catch (error) {
    statusText.textContent = 'Session failed';
    console.error(error);
  }
}

async function navigate(url) {
  if (!state.sessionId) {
    await createSession();
    return;
  }

  const cleanedUrl = url.trim() || state.currentUrl;
  state.currentUrl = cleanedUrl;
  addressInput.value = cleanedUrl;
  statusText.textContent = 'Loading page...';

  try {
    const response = await fetch('/api/browser/navigate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sessionId: state.sessionId, url: cleanedUrl })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || 'Navigation failed');
    }

    if (data.screenshot) {
      browserView.src = `data:image/png;base64,${data.screenshot}`;
      browserView.style.display = 'block';
      emptyState.style.display = 'none';
    }

    if (data.title) {
      browserTitle.textContent = data.title;
    }

    state.title = data.title || 'Remote browser';
    statusText.textContent = 'Ready';
  } catch (error) {
    statusText.textContent = 'Error';
    console.error(error);
  }
}

async function refresh() {
  if (!state.sessionId) {
    await createSession();
    return;
  }

  statusText.textContent = 'Refreshing...';

  try {
    const response = await fetch('/api/browser/refresh', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sessionId: state.sessionId })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || 'Refresh failed');
    }

    if (data.screenshot) {
      browserView.src = `data:image/png;base64,${data.screenshot}`;
      browserView.style.display = 'block';
      emptyState.style.display = 'none';
    }

    statusText.textContent = 'Ready';
  } catch (error) {
    statusText.textContent = 'Refresh failed';
    console.error(error);
  }
}

async function closeSession() {
  if (!state.sessionId) return;

  try {
    await fetch('/api/browser/close-session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sessionId: state.sessionId })
    });
  } catch (error) {
    console.error(error);
  }

  state.sessionId = null;
  browserView.style.display = 'none';
  emptyState.style.display = 'block';
  browserTitle.textContent = 'New session';
  statusText.textContent = 'Idle';
}

document.getElementById('goBtn').addEventListener('click', () => navigate(addressInput.value));
document.getElementById('refreshBtn').addEventListener('click', refresh);
document.getElementById('newSessionBtn').addEventListener('click', async () => {
  await closeSession();
  await createSession();
});

addressInput.addEventListener('keydown', (event) => {
  if (event.key === 'Enter') {
    navigate(addressInput.value);
  }
});

document.querySelectorAll('.site-button').forEach((button) => {
  button.addEventListener('click', () => {
    const target = button.dataset.url;
    addressInput.value = target;
    navigate(target);
  });
});

window.addEventListener('beforeunload', closeSession);

createSession();
